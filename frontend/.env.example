# Frontend environment variables for preview/development

# Preferred backend base URL.
# In preview, the frontend runs on :3000 and backend on :3001; leave commented to auto-derive http(s)://<host>:3001 from current origin.
# REACT_APP_API_BASE=https://vscode-internal-25119-beta.beta01.cloud.kavia.ai:3001

# Alternate env var supported (same effect as REACT_APP_API_BASE); if both set, REACT_APP_API_BASE wins.
# REACT_APP_BACKEND_URL=https://vscode-internal-25119-beta.beta01.cloud.kavia.ai:3001

# Healthcheck path on the backend. Defaults to '/' if unset.
# If your backend exposes a specific health route (e.g., /health), set it here.
# REACT_APP_HEALTHCHECK_PATH=/health

# Optional: Link to backend OpenAPI/Swagger docs for convenience in the UI; if not set, the client will derive /docs from API base.
# REACT_APP_BACKEND_DOCS_URL=https://vscode-internal-25119-beta.beta01.cloud.kavia.ai:3001/docs
