# Frontend environment variables for preview and local development
# Leave these empty in preview; the app derives sensible defaults.

# API base resolution priority:
# 1) REACT_APP_API_BASE
# 2) REACT_APP_BACKEND_URL
# 3) Derived from current origin by switching the port to 3001
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Healthcheck path for backend. Defaults to "/"
REACT_APP_HEALTHCHECK_PATH=/

# Optional explicit URL to backend docs. Defaults to ${API_BASE}/docs if unset
REACT_APP_BACKEND_DOCS_URL=

# Frontend metadata and runtime flags (optional)
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Feature flags (optional JSON or CSV by convention)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
