# Frontend environment variables for AI Test Suite (React)

# API base URL (preferred). Example: https://your-backend.example.com
REACT_APP_API_BASE=

# Alternate backend URL name supported by client
REACT_APP_BACKEND_URL=

# Frontend base URL (optional; for external links)
REACT_APP_FRONTEND_URL=

# Websocket URL (not used in MVP; reserved)
REACT_APP_WS_URL=

# Node environment (development|production)
REACT_APP_NODE_ENV=development

# Disable Next.js telemetry (reserved)
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Enable JS source maps (CRA respects GENERATE_SOURCEMAP env)
REACT_APP_ENABLE_SOURCE_MAPS=true

# Frontend dev server port
REACT_APP_PORT=3000

# Reverse proxy trust (reserved)
REACT_APP_TRUST_PROXY=true

# Logging level (debug|info|warn|error)
REACT_APP_LOG_LEVEL=info

# Health check path for backend (default '/')
REACT_APP_HEALTHCHECK_PATH=/

# Feature flags (comma-separated)
REACT_APP_FEATURE_FLAGS=

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
